<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 메인 스크롤 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="56dp"> <!-- 하단 내비바 공간 -->

        <!-- 유튜브 스타일 상단 앱바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/bg_dark"
            android:elevation="4dp">

            <!-- 유튜브 로고 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MyPlayer"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.05" />

            <!-- 우측 아이콘들 (검색, 알림, 프로필 등) -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnSearchTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_primary"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/text_primary"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 카테고리 칩 (가로 스크롤) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/bg_dark"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/chipsCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- 기본 카테고리 칩들 -->
                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="전체"
                    android:textColor="@color/bg_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="음악"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="게임"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="영화"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="라이브"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 유튜브 스타일 2열 그리드 리사이클러뷰 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMainFeed"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- 기존 코드 호환을 위한 숨겨진 뷰들 (기능 유지용) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <View android:id="@+id/rootScroll" />
            <EditText android:id="@+id/etHomeSearch" />
            <View android:id="@+id/btnTheme" />
            <View android:id="@+id/btnStats" />
            <View android:id="@+id/btnSmartPlaylist" />
            <View android:id="@+id/btnLocalMedia" />
            <View android:id="@+id/btnAudioHome" />
            <View android:id="@+id/btnPlaylist" />
            <View android:id="@+id/btnMyPlaylists" />
            <View android:id="@+id/btnStartSearch" />
            <View android:id="@+id/tvHistoryMore" />
            <View android:id="@+id/tvDownloadsMore" />
            <View android:id="@+id/tvTrendingMore" />
            <View android:id="@+id/tvClearSearches" />
            <View android:id="@+id/emptyState" />
            <LinearLayout android:id="@+id/sectionRecent"><LinearLayout android:id="@+id/chipsContainer" /></LinearLayout>
            <LinearLayout android:id="@+id/sectionHistory"><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHistory" /></LinearLayout>
            <LinearLayout android:id="@+id/sectionRelated"><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRelated" /></LinearLayout>
            <LinearLayout android:id="@+id/sectionChannels"><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChannels" /></LinearLayout>
            <LinearLayout android:id="@+id/sectionBookmarks"><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBookmarks" /></LinearLayout>
            <LinearLayout android:id="@+id/sectionDownloads"><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDownloads" /></LinearLayout>
            <LinearLayout android:id="@+id/sectionTrending"><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvTrending" /></LinearLayout>
            <LinearLayout android:id="@+id/sectionSubscriptions"><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSubscriptions" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 하단 내비게이션 바 (유튜브 스타일) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@color/bg_surface"
        app:itemIconTint="@color/text_primary"
        app:itemTextColor="@color/text_primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
